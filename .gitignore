# 依赖文件 - 保留lock文件确保版本一致性
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python虚拟环境 - 太大，用户需重新安装
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# 构建输出和缓存 - 可重新生成
build/
dist/
.next/
*.tsbuildinfo
coverage/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# 日志文件 - 只忽略大日志文件，保留重要日志
**/logs/*.log
**/nacos/logs/
*.log.20*
alipay-jraft.log
nacos_gc.log*

# 系统文件
.DS_Store
Thumbs.db

# 临时文件
*.tmp
*.temp
*.bak
*.old

# 压缩包和备份
*.zip
*.tar
*.gz
*.rar

# IDE配置 - 保留项目配置
.vscode/settings.json
.idea/workspace.xml
.idea/tasks.xml
*.swp
*.swo
*~

.claude/
# 本地密钥和运行数据
.env
.env.*
!.env.example
backend/config-city/nacos/data/
backend/config-city/nacos/target/
backend/prtsc/*
